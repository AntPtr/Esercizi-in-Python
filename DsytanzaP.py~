import math

def Distanza(X1, Y2, X2, Y2):
    return math.sqrt(pow(X1 - X2, 2) + pow(Y1 - Y2, 2))


def main():
    print("DISTANZA TRA DUE PUNTI")

    X1 = float(input("Inserire x1: "))
    Y1 = float(input("Inserire y1: "))
    X2 = float(input("Inserire x2: "))
    Y2 = float(input("Inserire y2: "))

    print("La distanza tra i due punti e: ", Distanza(X1, Y1, X2, Y2))


main()
